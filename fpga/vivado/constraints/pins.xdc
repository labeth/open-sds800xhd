# ---- ADC data clocks (DCLK, 500 MHz). AD5/AD4 for group A, L7/L6 for group B.
# UNVERIFIED (U4).
set_property -dict {PACKAGE_PIN AD5 IOSTANDARD LVDS DIFF_TERM_ADV TERM_100} [get_ports adc_a_dclk_p]
set_property -dict {PACKAGE_PIN AD4 IOSTANDARD LVDS DIFF_TERM_ADV TERM_100} [get_ports adc_a_dclk_n]
set_property -dict {PACKAGE_PIN L7 IOSTANDARD LVDS DIFF_TERM_ADV TERM_100} [get_ports adc_b_dclk_p]
set_property -dict {PACKAGE_PIN L6 IOSTANDARD LVDS DIFF_TERM_ADV TERM_100} [get_ports adc_b_dclk_n]

# ---- held low: DCLK_RST of the two ADCs (spec 12 §6.3; function UNVERIFIED, U6)
set_property -dict {PACKAGE_PIN B4 IOSTANDARD LVDS} [get_ports adc_dclk_rst_p[0]]
set_property -dict {PACKAGE_PIN A4 IOSTANDARD LVDS} [get_ports adc_dclk_rst_n[0]]
set_property -dict {PACKAGE_PIN A9 IOSTANDARD LVDS} [get_ports adc_dclk_rst_p[1]]
set_property -dict {PACKAGE_PIN A8 IOSTANDARD LVDS} [get_ports adc_dclk_rst_n[1]]
# C3/C2 (forwarded clock) and D11: targets UNVERIFIED (U7); left unused.

# ---- ADC serial port: chip selects from EMIO GPIO 0/1, SDO read-back mux (spec 12 §7.2)
set_property -dict {PACKAGE_PIN A6 IOSTANDARD LVCMOS18 DRIVE 12} [get_ports adc_cs_n[0]]
set_property -dict {PACKAGE_PIN A7 IOSTANDARD LVCMOS18 DRIVE 12} [get_ports adc_cs_n[1]]
set_property -dict {PACKAGE_PIN A13 IOSTANDARD LVCMOS15} [get_ports adc_sdo[0]]
set_property -dict {PACKAGE_PIN B13 IOSTANDARD LVCMOS15} [get_ports adc_sdo[1]]
set_property -dict {PACKAGE_PIN J11 IOSTANDARD LVCMOS33 DRIVE 12} [get_ports spi1_miso]

# ---- Ethernet PHY, GEM0 over EMIO, MII (spec 12 §4.2): LVCMOS33, pull-ups, outputs 12 mA
set_property -dict {PACKAGE_PIN AH13 IOSTANDARD LVCMOS33 PULLUP TRUE DRIVE 12} [get_ports {gem_txd[0]}]
set_property -dict {PACKAGE_PIN AE13 IOSTANDARD LVCMOS33 PULLUP TRUE DRIVE 12} [get_ports {gem_txd[1]}]
