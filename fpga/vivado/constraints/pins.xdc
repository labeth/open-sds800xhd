set_property -dict {PACKAGE_PIN AB14 IOSTANDARD LVCMOS33 PULLUP TRUE DRIVE 12} [get_ports {gem_tx_en}]
set_property -dict {PACKAGE_PIN AA13 IOSTANDARD LVCMOS33 PULLUP TRUE} [get_ports {gem_tx_clk}]
set_property -dict {PACKAGE_PIN AB15 IOSTANDARD LVCMOS33 PULLUP TRUE} [get_ports {gem_rx_clk}]
set_property -dict {PACKAGE_PIN Y13 IOSTANDARD LVCMOS33 PULLUP TRUE} [get_ports {gem_rxd[0]}]
set_property -dict {PACKAGE_PIN W12 IOSTANDARD LVCMOS33 PULLUP TRUE} [get_ports {gem_rxd[1]}]
set_property -dict {PACKAGE_PIN W11 IOSTANDARD LVCMOS33 PULLUP TRUE} [get_ports {gem_rxd[2]}]
set_property -dict {PACKAGE_PIN Y12 IOSTANDARD LVCMOS33 PULLUP TRUE} [get_ports {gem_rxd[3]}]
set_property -dict {PACKAGE_PIN AA12 IOSTANDARD LVCMOS33 PULLUP TRUE} [get_ports {gem_rx_dv}]
set_property -dict {PACKAGE_PIN Y14 IOSTANDARD LVCMOS33 PULLUP TRUE} [get_ports {gem_rx_er}]
set_property -dict {PACKAGE_PIN W14 IOSTANDARD LVCMOS33 PULLUP TRUE} [get_ports {gem_col}]
set_property -dict {PACKAGE_PIN W13 IOSTANDARD LVCMOS33 PULLUP TRUE} [get_ports {gem_crs}]
set_property -dict {PACKAGE_PIN AC14 IOSTANDARD LVCMOS33 PULLUP TRUE DRIVE 12} [get_ports {mdio_mdc}]
set_property -dict {PACKAGE_PIN AC13 IOSTANDARD LVCMOS33 PULLUP TRUE DRIVE 12} [get_ports {mdio_io}]

# ---- beeper: TTC0 wave-out 0 (spec 12 §4.2)
set_property -dict {PACKAGE_PIN AF11 IOSTANDARD LVCMOS33 DRIVE 12 PULLUP TRUE} [get_ports beeper]

# ---- LCD, parallel RGB666 (spec 12 §7.2), three groups of six; colour and bit
# order UNVERIFIED (U8); slow slew.
set_property -dict {PACKAGE_PIN AH10 IOSTANDARD LVCMOS33 DRIVE 4 SLEW SLOW} [get_ports {lcd_group0[0]}]
