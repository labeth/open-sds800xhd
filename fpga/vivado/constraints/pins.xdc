# ENGMODEL-OWNER-UNIT: FU-HD-PL-BUILD
# pins.xdc -- the open image's balls (SFVC784), from spec 12. Every line marked
# UNVERIFIED depends on a board fact spec 20 §14 lists; the build refuses to make
# a bitstream for the unit until fpga/vivado/verified.tcl says they are settled.

# ---- ADC data lanes (spec 12 §6.2). Lane k of a group is the k-th pair in the
# spec's list; which group is ADC0/ADC1 and the DI/DQ bit order are UNVERIFIED
# (U3): the capture block maps lanes to bits through its lane-map include.
# I/O standard and termination UNVERIFIED (U5): LVDS with internal 100-ohm
# termination assumed, HP banks 64/65 at 1.8 V (bank 66 is 1.8 V).
set_property -dict {PACKAGE_PIN AC9 IOSTANDARD LVDS DIFF_TERM_ADV TERM_100} [get_ports {adc_a_p[0]}]
set_property -dict {PACKAGE_PIN AD9 IOSTANDARD LVDS DIFF_TERM_ADV TERM_100} [get_ports {adc_a_n[0]}]
set_property -dict {PACKAGE_PIN AE9 IOSTANDARD LVDS DIFF_TERM_ADV TERM_100} [get_ports {adc_a_p[1]}]
