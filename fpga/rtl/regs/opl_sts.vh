// ENGMODEL-OWNER-UNIT: FU-HD-PL
// Status word slots of opl_regs' sts input: each read-only register of the
// open plane that reports cclk/mclk-side state reads one slot.
localparam integer STS_SYS_STATUS = 0, STS_SYS_CCLK_KHZ = 1, STS_SYS_ADC1_KHZ = 2,
  STS_ACQ_STATUS = 3, STS_ACQ_REC_LOST = 4, STS_ACQ_TRIG_TIME_LO = 5, STS_ACQ_TRIG_TIME_HI = 6,
  STS_ACQ_TRIG_POS = 7, STS_ACQ_TRIG_PHASE = 8, STS_ACQ_TRIG_FRAC = 9, STS_ACQ_TRIG_FLAGS = 10,
  STS_ACQ_WORDS = 11, STS_ACQ_SEG_TIME_LO = 12, STS_ACQ_SEG_TIME_HI = 13, STS_ACQ_SEG_POS = 14,
  STS_ACQ_SEG_FLAGS = 15, STS_TRIG_CANDIDATES = 16, STS_TRIG_ACCEPTED = 17, STS_PROTO_MATCHES = 18,
  STS_PROTO_EVENTS = 19, STS_PROTO_ERRORS = 20, STS_STREAM_HEAD = 21, STS_STREAM_SEQ = 22,
  STS_STREAM_LOST = 23, STS_STREAM_STATUS = 24, STS_STACK_STATUS = 25, STS_READOUT_STATUS = 26,
  STS_COUNTER_COUNT = 27, STS_COUNTER_PERIOD = 28, STS_COUNTER_STATUS = 29, STS_WORDS = 32;
